# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi yazın.
# Tüm ayarlar OCCUPANCY_ önekiyle ortam değişkeni olarak da verilebilir.

# Video kaynağı: dosya yolu, webcam indeksi ("0") veya rtsp:// adresi
OCCUPANCY_SOURCE=ornek/demo.mp4

# YOLO model ağırlığı (yoksa ilk çalıştırmada indirilir)
OCCUPANCY_MODEL_PATH=yolov8n.pt
OCCUPANCY_CONF_THRESHOLD=0.35

# Bölge tanımları (tools/roi_ciz.py ile üretilir)
OCCUPANCY_ZONES_PATH=ornek/zones.json
# Geçiş çizgisi etrafındaki kararsız bant (piksel). Büyütmek çizgi civarında
# duraksayan kişilerden kaynaklı çift saymayı azaltır, küçültmek hassaslaştırır.
OCCUPANCY_CROSSING_BAND_PX=25

# Veri ve çıktı konumları
OCCUPANCY_DB_PATH=data/occupancy.db
OCCUPANCY_REPORTS_DIR=reports
OCCUPANCY_LOGS_DIR=logs

# Web sunucusu
OCCUPANCY_HOST=127.0.0.1
OCCUPANCY_PORT=8000

# Kaç saniyede bir doluluk anlık görüntüsü kaydedilsin
OCCUPANCY_SNAPSHOT_INTERVAL_SEC=10

# Video dosyası bitince başa sarsın mı
OCCUPANCY_LOOP_VIDEO=true

OCCUPANCY_LOG_LEVEL=INFO
